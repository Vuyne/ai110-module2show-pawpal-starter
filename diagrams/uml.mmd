classDiagram
    %% PawPal+ — pet care planning assistant
    %% Keep this file updated so it matches your final implementation.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +set_preference(key, value) None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str recurrence
        +int weekday
        +time start_time
        +time end_time()
        +priority_rank() int
        +runs_on(weekday) bool
    }

    class Scheduler {
        +Owner owner
        +build_plan(pet, weekday) Plan
        +sort_tasks(tasks) list~Task~
        +fits(task, remaining) bool
        +has_conflict(task, scheduled) bool
        +explain(plan) str
    }

    class Plan {
        +list~Task~ scheduled
        +list~Task~ skipped
        +int total_minutes
        +str reasoning
    }

    Owner "1" *-- "many" Pet : owns
    Pet "1" *-- "many" Task : has
    Task ..> Priority : uses
    Scheduler "1" --> "1" Owner : reads constraints from
    Scheduler ..> Pet : reads tasks from
    Scheduler ..> Task : orders & assigns times
    Scheduler ..> Plan : produces
